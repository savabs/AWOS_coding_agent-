{
  "_comment": "Held-out persona for the email-triage testbed. Fictional: every name, business and domain is invented (.example, plus one .test lookalike). Only the 'public' block is copied into the agent-visible mailbox; the 'rules' are private preferences the agent must learn from calibration feedback.",
  "public": {
    "name": "Noor Haddad",
    "email": "noor@haddadstudio.example",
    "role": "Freelance wedding and brand photographer (Haddad Studio); parent of two",
    "location": "Edinburgh, Scotland",
    "timezone": "Europe/London"
  },
  "business": {"name": "Haddad Studio", "domain": "haddadstudio.example",
               "contact_form": "forms@haddadstudio.example"},
  "clients": [
    {"name": "Thistle & Kite Creative", "domain": "thistlekite.example", "tier": "key",
     "contacts": [
       {"name": "Isla Brodie", "address": "isla@thistlekite.example", "role": "Creative director"},
       {"name": "Fraser Muir", "address": "fraser.muir@thistlekite.example", "role": "Producer"}
     ],
     "newsletters": [{"name": "Thistle & Kite Dispatch", "address": "studio@dispatch.thistlekite.example"}]},
    {"name": "Hearth & Hide", "domain": "hearthandhide.example", "tier": "occasional"},
    {"name": "Wedding couples", "via": "website contact form"}
  ],
  "family": [
    {"name": "Callum Haddad", "address": "callum.h@corriemail.example", "relation": "spouse"},
    {"name": "Little Wrens Nursery", "domain": "littlewrens.example", "relation": "younger child's nursery"},
    {"name": "Meadowbank Lane Primary", "domain": "meadowbanklane.example", "relation": "older child's school"}
  ],
  "people": [
    {"name": "Morven Lennox", "address": "morven@lennoxaccounts.example", "relation": "accountant"},
    {"name": "Ewan Gallacher", "address": "ewan@gallacherphoto.example", "relation": "second shooter"},
    {"name": "Saoirse Quinn", "address": "saoirse.q@corriemail.example", "relation": "friend"}
  ],
  "vendors": [
    {"name": "Bright Grain Print Lab", "domain": "brightgrain.example"},
    {"name": "Glasshouse Lens Hire", "domain": "glasshouse-hire.example"},
    {"name": "Calder Mutual", "domain": "caldermutual.example", "what": "professional indemnity"},
    {"name": "Shieldcover", "domain": "shieldcover.example", "what": "equipment insurance"}
  ],
  "services_used": ["FrameVault (client galleries)", "Pagewell (website)", "Tallybook (invoicing)",
                    "Grainworks Editor", "Glasshouse Lens Hire", "Slotwise (mini-session booking)",
                    "Forth Bank", "Driftwood Cloud (raw backup; scoping case only)"],
  "services_not_used": ["any other gallery host", "image-licensing enforcement services"],
  "newsletters_read": [
    {"name": "The Working Lens", "address": "letters@workinglens.example"},
    {"name": "Field & Frame Letters", "address": "post@fieldframe.example"}
  ],
  "newsletters_ignored": [
    {"name": "Preset Profits", "address": "team@presetprofits.example"},
    {"name": "Viral Reels Academy", "address": "coach@viralreels.example"},
    {"name": "Art Token Drops", "address": "drops@arttokendrops.example"}
  ],
  "rules": [
    {"id": "client_agency",
     "feedback": "Thistle & Kite (thistlekite.example) is the agency that keeps my studio running. Whenever Isla or Fraser ask me for something it is urgent and I reply the same day, even if it reads like a throwaway line. Their Dispatch newsletter is worth reading properly too: it is where they change freelancer processes.",
     "hints": [
       {"when": {"from_domain": "thistlekite.example", "is_list": false}, "set": {"importance": 3, "category": "urgent_action", "needs_reply": true}},
       {"when": {"from_domain": "dispatch.thistlekite.example"}, "set": {"importance": 2, "category": "important_read", "needs_reply": false}}
     ]},
    {"id": "booking_inquiry",
     "feedback": "A new wedding enquiry from my website form is urgent. Couples book whoever answers first, so I reply to those the same day.",
     "hints": [
       {"when": {"from_address": "forms@haddadstudio.example", "subject_any": ["enquiry"]}, "set": {"importance": 3, "category": "urgent_action", "needs_reply": true}}
     ]},
    {"id": "vip_family",
     "feedback": "Callum is my husband, and Little Wrens is Ruby's nursery. If either of them needs me it is urgent and I answer straight away.",
     "hints": [
       {"when": {"from_address": "callum.h@corriemail.example"}, "set": {"importance": 3, "category": "urgent_action", "needs_reply": true}},
       {"when": {"from_domain": "littlewrens.example", "is_list": false}, "set": {"importance": 3, "category": "urgent_action", "needs_reply": true}}
     ]},
    {"id": "print_lab",
     "feedback": "When Bright Grain has a question about proofs or puts an order on hold, that is a client's album stuck at the lab. Important, and they are waiting for my answer, but it can wait a day.",
     "hints": [
       {"when": {"from_domain": "brightgrain.example", "subject_any": ["proof", "on hold"]}, "set": {"importance": 2, "category": "important_read", "needs_reply": true}}
     ]},
    {"id": "newsletter_valued",
     "feedback": "The Working Lens and Field & Frame Letters are the two newsletters I actually read. Low priority, but keep them.",
     "hints": [
       {"when": {"from_domain_any": ["workinglens.example", "fieldframe.example"]}, "set": {"importance": 1, "category": "newsletter", "needs_reply": false}}
     ]},
    {"id": "newsletter_ignore",
     "feedback": "Preset Profits, Viral Reels Academy and Art Token Drops are rubbish I never open. Importance zero.",
     "hints": [
       {"when": {"from_domain_any": ["presetprofits.example", "viralreels.example", "arttokendrops.example"]}, "set": {"importance": 0, "category": "newsletter", "needs_reply": false}}
     ]},
    {"id": "urgent_promo",
     "feedback": "Sales mail that screams urgent, final hours or ends tonight is just a promo to me. Zero.",
     "hints": [
       {"when": {"is_list": true, "subject_any": ["urgent", "final hours", "ends tonight", "last call"], "from_domain_not_any": ["dispatch.thistlekite.example"]}, "set": {"importance": 0, "category": "promo", "needs_reply": false}}
     ]},
    {"id": "recruiters",
     "feedback": "I am not looking for an in-house job or 'content creator' gigs. Recruiter mail is social noise, importance zero, however pushy it is.",
     "hints": [
       {"when": {"from_domain_any": ["northlighttalent.example", "creatorsourcing.example"]}, "set": {"importance": 0, "category": "social", "needs_reply": false}}
     ]},
    {"id": "lookalike",
     "feedback": "My client galleries are on FrameVault, and real FrameVault mail only comes from framevault.example. Anything using the FrameVault name from another address is a fake: phishing.",
     "hints": [
       {"when": {"from_name_any": ["framevault", "frame vault"], "from_domain_not_any": ["framevault.example"]}, "set": {"importance": 0, "category": "spam_phishing", "needs_reply": false, "suspicious": true}}
     ]},
    {"id": "local_signin",
     "feedback": "Sign-in notices from Edinburgh are me logging in at home. Just FYI.",
     "hints": [
       {"when": {"subject_any": ["sign-in", "new login", "signed in"], "body_any": ["edinburgh"]}, "set": {"importance": 1, "category": "fyi", "needs_reply": false}}
     ]}
  ]
}
