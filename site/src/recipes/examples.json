{"slug": "timesheet", "tag": "Forms", "recipe": {"awos_recipe": 1,
 "name": "Fill the weekly timesheet, stop before Submit",
 "description": "Fills a standard 5 x 8 hour week on a timesheet portal and stops on the review screen, so you check it and press Submit yourself.",
 "start_url": "https://hr.example.org/timesheets",
 "params": [{"name": "project", "label": "Project code", "example": "PRJ-1042", "kind": "text"}],
 "steps": [
  {"action": "click", "loc": {"tag": "button", "name": "New timesheet"}},
  {"action": "fill", "loc": {"tag": "input", "label": "Project code"}, "value": "{{project}}"},
  {"action": "fill", "loc": {"tag": "input", "label": "Monday"}, "value": "8"},
  {"action": "fill", "loc": {"tag": "input", "label": "Tuesday"}, "value": "8"},
  {"action": "fill", "loc": {"tag": "input", "label": "Wednesday"}, "value": "8"},
  {"action": "fill", "loc": {"tag": "input", "label": "Thursday"}, "value": "8"},
  {"action": "fill", "loc": {"tag": "input", "label": "Friday"}, "value": "8"},
  {"action": "fill", "loc": {"tag": "textarea", "label": "Notes"}, "ask": true},
  {"action": "click", "loc": {"tag": "button", "name": "Review"}}
 ],
 "checks": {"goal": "The review screen shows 40 hours, ready for you to submit.", "expect_text": ["Total 40 h", "Submit"],
            "expect_url": null, "expect_download": null},
 "created_with": "AWOS Replay example"}},

{"slug": "order-status", "tag": "Orders", "recipe": {"awos_recipe": 1,
 "name": "Check an order's delivery status",
