 "params": [{"name": "order", "label": "Order number", "example": "100-2245-77", "kind": "text"},
            {"name": "zip", "label": "Postcode on the order", "example": "94016", "kind": "text"}],
 "steps": [
  {"action": "fill", "loc": {"tag": "input", "label": "Order number"}, "value": "{{order}}"},
  {"action": "fill", "loc": {"tag": "input", "label": "Billing postcode"}, "value": "{{zip}}"},
  {"action": "click", "loc": {"tag": "button", "name": "Track order"}},
  {"action": "read", "loc": {"tag": "p", "name": "Delivery status"}}
 ],
 "checks": {"goal": "The tracking page for the order is open and shows a status.", "expect_text": ["Status"],
            "expect_url": "/orders/track/", "expect_download": null},
 "created_with": "AWOS Replay example"}},

{"slug": "job-alert", "tag": "Alerts", "recipe": {"awos_recipe": 1,
