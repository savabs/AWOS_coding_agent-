  {"action": "click", "loc": {"tag": "button", "name": "Download PDF"}}
 ],
 "checks": {"goal": "The invoice PDF for the chosen month is saved.", "expect_text": ["Invoice"], "expect_url": null,
            "expect_download": {"name_regex": "^invoice.*\\.pdf$"}},
 "created_with": "AWOS Replay example"}},

