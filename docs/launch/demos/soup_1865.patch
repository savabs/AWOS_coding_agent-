---
 changelog.d/0.76.0/1865.fixed.md |  1 +
 src/soup_cli/eval/gate.py        | 36 ++++++++--------
 tests/test_eval_gate.py          | 70 ++++++++++++++++++++++++++++++++
 3 files changed, 91 insertions(+), 16 deletions(-)
 create mode 100644 changelog.d/0.76.0/1865.fixed.md

diff --git a/changelog.d/0.76.0/1865.fixed.md b/changelog.d/0.76.0/1865.fixed.md
new file mode 100644
index 0000000..5cbb527
--- /dev/null
+++ b/changelog.d/0.76.0/1865.fixed.md
@@ -0,0 +1 @@
+- `soup eval gate`: an integer baseline score too large for a float (such as `10**400`) now fails with a usage error (exit code 3) instead of an `OverflowError`. The baseline helpers in `eval/gate.py` raise `ValueError` for it, the same as for nan and inf. (#1865)
diff --git a/src/soup_cli/eval/gate.py b/src/soup_cli/eval/gate.py
index 8d875fc..c791725 100644
--- a/src/soup_cli/eval/gate.py
+++ b/src/soup_cli/eval/gate.py
@@ -165,12 +165,7 @@ def stamp_baseline_scores(scores: Mapping[str, float]) -> dict[str, object]:
                 f"baseline score for {name!r} must be a number, "
                 f"got {type(value).__name__}"
             )
-        fval = float(value)
-        if not math.isfinite(fval):
-            raise ValueError(
-                f"baseline score for {name!r} must be finite, got {value}"
-            )
-        clean[name] = fval
+        clean[name] = _finite_score(value, name=name, context="baseline score")
     return {
         _BASELINE_SCORES_KEY: clean,
         _BASELINE_PROVENANCE_KEY: current_baseline_stamp(),
@@ -199,6 +194,23 @@ def write_baseline_file(path: str, scores: Mapping[str, float]) -> str:
     )
 
 
+def _finite_score(value: object, *, name: str, context: str) -> float:
+    """Return ``value`` as a finite float or raise ValueError.
+
+    An int too large for a float (``10**400``) is refused rather than clamped,
+    and the raw value is never echoed into the message.
+    """
+    try:
+        fval = float(value)  # type: ignore[arg-type]
+    except OverflowError:
+        raise ValueError(
+            f"{context} for {name!r} must be finite (out of range)"
+        ) from None
+    if not math.isfinite(fval):
+        raise ValueError(f"{context} for {name!r} must be finite, got {value}")
+    return fval
+
+
 def _coerce_score_map(raw: Mapping[object, object], *, context: str) -> dict[str, float]:
     out: dict[str, float] = {}
     for key, value in raw.items():
@@ -210,12 +222,7 @@ def _coerce_score_map(raw: Mapping[object, object], *, context: str) -> dict[str
                 f"{context}: score for {name!r} must be a number, "
                 f"got {type(value).__name__}"
             )
-        fval = float(value)
-        if not math.isfinite(fval):
-            raise ValueError(
-                f"{context}: score for {name!r} must be finite, got {value}"
-            )
-        out[name] = fval
+        out[name] = _finite_score(value, name=name, context=f"{context}: score")
     return out
 
 
@@ -603,10 +610,7 @@ def run_gate(
                 f"baseline score for {base_name!r} must be a number, "
                 f"got {type(base_val).__name__}"
             )
-        if not math.isfinite(base_val):
-            raise ValueError(
-                f"baseline score for {base_name!r} must be finite, got {base_val}"
-            )
+        _finite_score(base_val, name=base_name, context="baseline score")
     task_results: list[GateTaskResult] = []
     any_regressed = False
     any_failed_threshold = False
diff --git a/tests/test_eval_gate.py b/tests/test_eval_gate.py
index bc808b6..ad3ebcc 100644
--- a/tests/test_eval_gate.py
+++ b/tests/test_eval_gate.py
@@ -172,6 +172,76 @@ class TestBaseline:
         with pytest.raises(ValueError, match="not found|missing"):
             resolve_baseline("registry://nonexistent_entry")
 
+    @pytest.mark.parametrize("huge", [10**400, -10**400])
+    def test_resolve_flat_file_huge_int_refused(self, tmp_path, monkeypatch, huge):
+        monkeypatch.chdir(tmp_path)
+        from soup_cli.eval.gate import resolve_baseline
+
+        baseline_file = tmp_path / "baseline.json"
+        baseline_file.write_text(f'{{"control": {huge}}}', encoding="utf-8")
+        with pytest.raises(ValueError, match="control.*finite"):
+            resolve_baseline(str(baseline_file))
+
+    @pytest.mark.parametrize("huge", [10**400, -10**400])
+    def test_resolve_stamped_file_huge_int_refused(self, tmp_path, monkeypatch, huge):
+        monkeypatch.chdir(tmp_path)
+        from soup_cli.eval.gate import resolve_baseline
+
+        baseline_file = tmp_path / "baseline.json"
+        baseline_file.write_text(
+            f'{{"scores": {{"control": {huge}}}, "provenance": {{}}}}',
+            encoding="utf-8",
+        )
+        with pytest.raises(ValueError, match="control.*finite"):
+            resolve_baseline(str(baseline_file))
+
+    @pytest.mark.parametrize("huge", [10**400, -10**400])
+    def test_stamp_and_write_huge_int_refused(self, tmp_path, monkeypatch, huge):
+        monkeypatch.chdir(tmp_path)
+        from soup_cli.eval.gate import stamp_baseline_scores, write_baseline_file
+
+        with pytest.raises(ValueError, match="control.*finite"):
+            stamp_baseline_scores({"control": huge})
+        out = tmp_path / "baseline.json"
+        with pytest.raises(ValueError, match="control.*finite"):
+            write_baseline_file(str(out), {"control": huge})
+        assert not out.exists()
+
+    @pytest.mark.parametrize("huge", [10**400, -10**400])
+    def test_run_gate_huge_int_baseline_refused(self, tmp_path, monkeypatch, huge):
+        monkeypatch.chdir(tmp_path)
+        from soup_cli.eval.gate import EvalSuite, GateTask, run_gate
+
+        tasks_file = tmp_path / "tasks.jsonl"
+        tasks_file.write_text(
+            '{"prompt": "2+2=", "expected": "4", "scorer": "exact"}\n',
+            encoding="utf-8",
+        )
+        suite = EvalSuite(
+            suite="huge",
+            tasks=[GateTask(
+                type="custom", name="control", tasks=str(tasks_file),
+                scorer="exact", threshold=0.5,
+            )],
+        )
+        with pytest.raises(ValueError, match="control.*finite") as exc_info:
+            run_gate(suite, generate_fn=lambda p: "4", baseline={"control": huge})
+        # The raw value must not be echoed (a huge int prints in full).
+        assert str(huge) not in str(exc_info.value)
+
+    def test_eval_gate_huge_int_baseline_exit_3(self, tmp_path, monkeypatch):
+        monkeypatch.chdir(tmp_path)
+        suite = tmp_path / "gate.yaml"
+        suite.write_text(yaml.safe_dump({"suite": "s", "tasks": []}),
+                         encoding="utf-8")
+        baseline_file = tmp_path / "baseline.json"
+        baseline_file.write_text(f'{{"control": {10**400}}}', encoding="utf-8")
+        result = runner.invoke(
+            app, ["eval", "gate", "--suite", str(suite),
+                  "--baseline", str(baseline_file)],
+        )
+        assert result.exit_code == 3, (result.output, repr(result.exception))
+
 
