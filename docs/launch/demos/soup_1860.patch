index 0000000..65b34ca
--- /dev/null
+++ b/tests/test_issue1860_non_object_rows.py
@@ -0,0 +1,44 @@
+"""Issue #1860 - non-object JSONL rows must warn and skip, not crash data commands."""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+from typer.testing import CliRunner
+
+from soup_cli.cli import app
+
+runner = CliRunner()
+
+GOOD_1 = {"instruction": "Q1", "input": "", "output": "A1"}
+GOOD_2 = {"instruction": "Q2", "input": "", "output": "A2"}
+
+
+def _write_rows(tmp_path, bad_value):
+    path = tmp_path / "data.jsonl"
+    lines = [
+        json.dumps(GOOD_1),
+        json.dumps(bad_value),
+        json.dumps(GOOD_2),
+    ]
+    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return path
+
+
+@pytest.mark.parametrize("bad_value", ["abc", [1, 2], 42, None])
+@pytest.mark.parametrize("command", ["review", "inspect", "validate", "stats", "dedup"])
+def test_non_object_row_warns_and_does_not_crash(tmp_path, monkeypatch, command, bad_value):
+    monkeypatch.chdir(tmp_path)
+    path = _write_rows(tmp_path, bad_value)
+    args = ["data", command, str(path)]
+    if command == "dedup":
+        pytest.importorskip("datasketch", reason="dedup needs soup-cli[data]")
+        args += ["--output", str(tmp_path / "out.jsonl")]
+    result = runner.invoke(app, args)
+    output = result.output
+    assert "AttributeError" not in output, output
+    assert not isinstance(result.exception, AttributeError), repr(result.exception)
+    assert result.exit_code == 0, (output, repr(result.exception))
+    assert "line 2 is a JSON" in output, output
+    assert "not an object" in output, output
diff --git a/tests/test_loader.py b/tests/test_loader.py
index 8b8750a..455be74 100644
--- a/tests/test_loader.py
+++ b/tests/test_loader.py
@@ -36,6 +36,33 @@ def test_load_json_not_array(tmp_path: Path):
         load_raw_data(path)
 
 
+def test_load_jsonl_skips_non_object_rows(tmp_path: Path, capsys):
+    """Non-object JSONL lines (#1860) are skipped with a line-numbered warning."""
+    path = tmp_path / "data.jsonl"
+    content = (
+        json.dumps({"instruction": "Q1", "output": "A1"}) + "\n"
+        + json.dumps("abc") + "\n"
+        + json.dumps({"instruction": "Q2", "output": "A2"}) + "\n"
+    )
+    path.write_text(content)
+    data = load_raw_data(path)
+    assert [row["instruction"] for row in data] == ["Q1", "Q2"]
+    assert "line 2 is a JSON string, not an object" in capsys.readouterr().out
+
+
+def test_load_json_skips_non_object_items(tmp_path: Path, capsys):
+    """Non-object items in a .json array (#1860) are skipped with an item-numbered warning."""
+    path = tmp_path / "data.json"
+    path.write_text(json.dumps([
+        {"instruction": "Q1", "output": "A1"},
+        7,
+        {"instruction": "Q2", "output": "A2"},
+    ]))
+    data = load_raw_data(path)
+    assert [row["instruction"] for row in data] == ["Q1", "Q2"]
+    assert "item 2 is a JSON number, not an object" in capsys.readouterr().out
+
+
