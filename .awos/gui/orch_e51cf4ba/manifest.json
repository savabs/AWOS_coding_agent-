      "unified_diff": "--- scaffold/agent/virtual_execution_runtime.py (before)\n+++ scaffold/agent/virtual_execution_runtime.py (after)\n@@ -0,0 +1,56 @@\n+import os\n\n+import shutil\n\n+import tempfile\n\n+from pathlib import Path\n\n+\n\n+from ..config import AgentConfig\n\n+\n\n+\n\n+class VirtualExecutionRuntime:\n\n+    \"\"\"\n\n+    Manages the virtual execution environment for the agent.\n\n+    This includes creating and managing a temporary workspace,\n\n+    and potentially a Git worktree for isolated execution.\n\n+    \"\"\"\n\n+\n\n+    def __init__(self, config: AgentConfig):\n\n+        self.config = config\n\n+        self.temp_dir: Path | None = None\n\n+        self.worktree_path: Path | None = None\n\n+\n\n+    @property\n\n+    def worktree_enabled(self) -> bool:\n\n+        \"\"\"Returns True when AWOS_USE_WORKTREE is enabled.\"\"\"\n\n+        return os.getenv(\"AWOS_USE_WORKTREE\", \"false\").lower() == \"true\"\n\n+\n\n+    def create_workspace(self) -> Path:\n\n+        \"\"\"\n\n+        Creates a temporary workspace directory for the agent's execution.\n\n+        \"\"\"\n\n+        if self.worktree_enabled:\n\n+            # Logic for creating a worktree\n\n+            # For now, let's just create a temp dir even if worktree is enabled\n\n+            # The actual worktree creation logic would be more involved\n\n+            self.temp_dir = Path(tempfile.mkdtemp(prefix=\"awos_workspace_\"))\n\n+            self.worktree_path = self.temp_dir # Placeholder\n\n+            return self.worktree_path\n\n+        else:\n\n+            self.temp_dir = Path(tempfile.mkdtemp(prefix=\"awos_workspace_\"))\n\n+            return self.temp_dir\n\n+\n\n+    def get_workspace_path(self) -> Path:\n\n+        \"\"\"\n\n+        Returns the path to the current workspace.\n\n+        \"\"\"\n\n+        if self.temp_dir is None:\n\n+            raise RuntimeError(\"Workspace has not been created yet.\")\n\n+        return self.temp_dir\n\n+\n\n+    def 