# Settings for .github/workflows/rl-web-judge-kaggle.yml (push to bench-cloud/rl-wj7b-**; no secrets).
# Judges Online-Mind2Web runs with the open WebJudge-7B on Kaggle (free T4 x2, kaggle/web-judge/), the official
# judge now that OpenAI shut down o4-mini (2026-10-23).
# SOURCE_RUN: the GitHub run id of an rl-web-kaggle run (its artifacts rl-web-merged-<model>-<split>).
SOURCE_RUN="40239278459"
MODELS="qwen3.5-4b a-final"
SPLIT="dev"
# N_TASKS: judge only the first N task folders of each run (0 = all): a smoke before the full judge run
N_TASKS=4
KERNEL_SLUG="awos-web-judge-smoke"
DATASET_SLUG="awos-web-judge-smoke-data"
# extra judge_config overrides, space-separated key=value (e.g. max_model_len=32768)
CONFIG=""
