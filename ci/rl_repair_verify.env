# Settings for .github/workflows/rl-repair-verify.yml (push to bench-cloud/rl-repair-verify-**; no secrets).
# Measures off-the-shelf / trained local models on the two narrow jobs the product gives the model:
#   repair: scripts/repair_bench.py --model local (pick the moved control from a shortlist, or NOT_FOUND)
#   verify: scripts/rl/eval_verifier.py (VERIFIED / NOT_DONE / UNSAFE from the final page; may only veto)
# MODELS: labels from ci/rl_eval.env MODEL_SPECS. One runner job per (model, bench).
MODELS="g7-rv2b"
BENCHES="repair verify"
# repair: every ambiguous case of the test families (dry run 2026-10-24: 1058 cases, ~170 prompt tokens)
REPAIR_SPLIT="test"
REPAIR_MAX_CALLS=1100
# verify: eval rows from these exam runs (base, G2 ck150, run A final: 3 x 249 episodes, real labels);
# a stratified sample of VERIFY_LIMIT rows (994 rows built 2026-10-24; prompts ~450 tokens at p50)
VERIFY_RUNS="40027334131 40068343837 40090089187"
VERIFY_LIMIT=500
