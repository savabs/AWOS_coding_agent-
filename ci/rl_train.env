# Settings for .github/workflows/rl-train-data.yml on push to bench-cloud/rl-train-data-** (no secrets, ever).
# COLLECT_RUNS = rl-eval collection run ids whose trajectories join the SFT set (empty = oracle demos only).
COLLECT_RUNS=""
ORACLE=true
ORACLE_WEIGHT=1
MAX_PER_TASK=4
SIZE=4B
# train_config overrides; max_steps=30 = the first Kaggle trial (does Qwen3.5 train on T4 at all?)
CONFIG="max_steps=30"
# true = upload the dataset to Kaggle and start the training kernel
PUSH=true
