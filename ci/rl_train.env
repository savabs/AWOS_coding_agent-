# Settings for .github/workflows/rl-train-data.yml on push to bench-cloud/rl-train-data-** (no secrets, ever).
# COLLECT_RUNS = run ids whose TRAIN-split artifacts join the SFT set: Qwen 4B collections (39852748367, 39864014413) + Claude Sonnet distillation (39973466526, 40003832864). Empty = oracle demos only.
COLLECT_RUNS="39852748367 39864014413 39973466526 40003832864"
ORACLE=true
ORACLE_WEIGHT=1
MAX_PER_TASK=4
SIZE=4B
# train_config overrides (empty = train.py defaults: 2 epochs, stop at 10.5 h)
CONFIG="run_name=A-resume3 resume_from=awos-rl-sft-a-resume resume_mode=exact mem_probe_steps=10"
# true = upload the dataset to Kaggle and start the training kernel
PUSH=true
KERNEL_SLUG=awos-rl-sft-a-resume3
DATASET_SLUG=awos-rl-sft-data-a-resume3
KERNEL_SOURCES="deeperisbetter/awos-rl-sft-a-resume"
