# Settings for .github/workflows/rl-export.yml on push to bench-cloud/rl-export-** (no secrets, ever).
# MODE: export (adapter from a Kaggle kernel or a GitHub artifact) | base (the untouched base model, same
# pipeline, for a fair A/B). NAME: output name (GGUF <NAME>-Q4_K_M.gguf, release tag rl-<NAME>).
MODE=export
SIZE=2B
NAME=qwen3.5-2b-g6-rv
# Kaggle kernel (USER/slug) to fetch the adapter from; empty = <KAGGLE_USERNAME>/awos-rl-sft
KERNEL=deeperisbetter/awos-rl-sft-g6-rv2b
# or: a GitHub run id whose artifact 'rl-sft-adapter' holds adapter/
ADAPTER_RUN_ID=
# publish a GitHub pre-release rl-<NAME> (rl-eval downloads the GGUF from it)
RELEASE=true
