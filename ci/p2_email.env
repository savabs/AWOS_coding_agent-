# Settings for .github/workflows/p2-email.yml (sourced by bash).
# One job per persona x seed x arm. Arms: on (cascade + uncertainty), off (legacy path),
# on_nounc (cascade, uncertainty checks off).
PERSONAS="trades sam clinic photographer bookshop"
SEEDS="7 101 102"
ARMS="on off"
# llama.cpp build tag (ggml-org/llama.cpp pre-release builds); b11146 = the laptop's
# Homebrew build (2026-09-23), so CI and laptop run the same llama.cpp.
LLAMA_TAG="b11146"
# Context per slot. 16k is plenty for 5-8 message batches and keeps RAM low on 16 GB runners.
CTX=16384
