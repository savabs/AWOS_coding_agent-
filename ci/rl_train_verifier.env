# Settings for .github/workflows/rl-train-verifier.yml (G5 verifier, docs/research/rl_cua_2026-10-22/VERIFIER.md).
# Read on push to bench-cloud/rl-train-verifier-**. No secrets, ever.
# TRAIN_RUNS: rl-eval runs whose TRAIN-split artifacts become verifier examples
#   (Qwen 4B collections 39852748367 39864014413 + Claude Sonnet distillation 39973466526 40003832864).
TRAIN_RUNS="39852748367 39864014413 39973466526 40003832864"
# EXAM_RUN: baseline exam (factory ood + miniwob holdout) -> eval.jsonl, never trained on.
EXAM_RUN="39817774382"
# train rows (class quotas 40% VERIFIED / 48% NOT_DONE / 12% UNSAFE of this; ~2.5k rows survive the caps)
MAX_TRAIN=2600
SIZE=4B
KERNEL_SLUG=awos-rl-sft-g5-verifier
DATASET_SLUG=awos-rl-sft-data-g5-verifier
# ~2.5k rows / 16 per step = ~155 steps; rows are ~0.6k tokens (shorter than the 1.1k SFT rows), so
# <= 35 s/step -> <= 90 min + ~3 min load. max_hours 2.2 is the hard stop (Kaggle quota resets ~23:40 UTC).
CONFIG="run_name=G5-verifier epochs=1 max_hours=2.2 eval_rows=100 eval_steps=50 eval_gen_rows=24 preflight_rows=8 save_steps=40"
# true = upload the dataset to Kaggle and start the training kernel
PUSH=true
