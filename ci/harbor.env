# Harbor head-to-head on GitHub Actions (.github/workflows/harbor.yml).
# KEY=VALUE, one per line, no quotes. Parsed by scripts/harbor_run.py ci-config.
# See ci/HARBOR.md.

# Terminal-Bench 2.1 on the Harbor registry, pinned to revision 6 (= latest on 2026-10-15).
DATASET=terminal-bench/terminal-bench-2-1@6
# sample (ci/harbor_tasks_sample.txt, 10 tasks) | seed:<seed>:<count> (ci/harbor_tasks_<seed>.txt,
# made by scripts/harbor_tasks.py stratified) | file:<path>
TASKS=sample
AGENTS=awos,claude-code,mini-swe-agent
MODEL=anthropic/claude-haiku-5-5
# Attempts per task (harbor -k) and concurrent trials inside one harbor run (-n).
N_ATTEMPTS=1
N_CONCURRENT=1
# The task list is split by index % N_SHARDS; the matrix is AGENTS x SHARDS.
N_SHARDS=2
SHARDS=all
MAX_PARALLEL=6
# USD per agent over ALL shards (each shard gets CAP_AGENT / N_SHARDS), recomputed from
# token usage after every task; and the per-trial cap handed to agents that take one
# (claude-code max_budget_usd, awos cost_cap, mini-swe-agent cost_limit). Empty = none.
CAP_AGENT=3
TASK_CAP=1.0
HARBOR_VERSION=0.24.0
# Installed agents run only with a pinned version.
PIN_CLAUDE_CODE=2.1.292
PIN_MINI_SWE_AGENT=2.4.6
PIN_OPENCODE=1.19.0
PIN_OPENHANDS=1.11.0
PIN_GOOSE=
# AWOS is installed from this repo at this ref (git archive of scaffold/agent).
AWOS_GIT_REF=HEAD
# Model calls per task: effectively unlimited so the task timeout binds for every agent.
AWOS_MAX_STEPS=1000
# Prune Docker images before a task when the runner has less free disk (GB).
PRUNE_BELOW_GB=10
# Stop starting tasks that could not finish inside this many minutes of the shard job.
SHARD_MINUTES=330
