# Settings for .github/workflows/rl-web-kaggle.yml (parsed by kaggle/web-eval/stage.py; no secrets, ever).
# Online-Mind2Web on the live web with llama.cpp on a free Kaggle T4 x2 instead of 4-vCPU GitHub runners
# (docs/specs/web_kaggle.md). The GGUFs are the pinned MODEL_SPECS of ci/rl_eval.env, LLAMA_TAG comes from
# there too, CTX_PER_SLOT from ci/rl_web.env. Secrets used by the workflow: HF_TOKEN (gated task file),
# KAGGLE_USERNAME + KAGGLE_KEY (or KAGGLE_API_TOKEN).
# Launch: push to a branch named bench-cloud/rl-web-kaggle-<anything>.

# Model labels from ci/rl_eval.env MODEL_SPECS, run one after the other in one kernel (at most 4).
MODELS="qwen3.5-4b a-final"
# dev = the fixed 100-task subset (scaffold/rl/web/data/dev_ids.json); all = the 300 tasks.
SPLIT="dev"
# Harness workers (one headless Chromium each) over the GPUs' servers, round-robin; slots per
# llama-server = ceil(WORKERS / GPUS). The T4 x2 machine has 4 vCPUs, which Chromium shares.
WORKERS=4
GPUS=2
# Per task: model steps, and wall clock in seconds (the same caps as ci/rl_web.env).
MAX_STEPS=25
MAX_SECONDS=900
# Kaggle names (under the KAGGLE_USERNAME account). The dataset is private and holds the gated task file.
KERNEL_SLUG="awos-web-eval"
DATASET_SLUG="awos-web-eval-data"
# Label on every ntfy progress ping (topic of kaggle/rl-sft/train.py).
RUN_NAME="web-kaggle-m0"
# USER/SLUG of an earlier kernel whose output holds llama-cuda-<tag>-sm75.tar.gz (a source build),
# attached as a kernel source so the build is skipped. Empty = prebuilt release binary, else build.
LLAMA_BUILD_SOURCE=""
# Stop the harness this many hours into the session (Kaggle ends sessions at 12 h; the run is resumable).
DEADLINE_HOURS=11
