# Settings for .github/workflows/rl-eval.yml (sourced by bash; no secrets, ever).
# Computer-use RL baseline evaluation (docs/research/rl_cua_2026-10-22/BASELINE_PROTOCOL.md)
# on free ubuntu-latest runners: CPU llama.cpp + headless Chromium + scaffold.rl.harness.

# One model per line:  label  hf_repo  file  revision  bytes  sha256  shards
# Each repo/file/revision/size/sha256 was checked on 2026-10-22 against the HF API
# (https://huggingface.co/api/models/<repo>?blobs=true: sha + siblings[].size/lfs.sha256)
# and a HEAD of the pinned resolve URL (x-repo-commit, x-linked-size). The download URL
# is https://huggingface.co/<repo>/resolve/<revision>/<file> and the sha256 is verified.
# shards = how many runner jobs one (model, source) pair is split into, so each job stays
# well under the 6 h job limit on 4 vCPU (9B on CPU is ~5-10x slower than 2B).
# qwen3.5-9b is the same file as the laptop's ~/.cache/awos-models/Qwen3.5-9B-Q4_K_M.gguf
# (5680522464 bytes); 2B/4B are the files .github/workflows/mac-model.yml uses.
# MiMo-V2.6-Distill-Qwen-9B is a thinking model: LocalGBNFModel already sends
# chat_template_kwargs.enable_thinking=false and llama-server runs with --reasoning off.
# ggml-org/MiMo-V2.6-Distill-Qwen-9B-GGUF only ships Q8_0 (9.5 GB), so Q4_K_M is bartowski's.
MODEL_SPECS="
qwen3.5-2b       unsloth/Qwen3.5-2B-GGUF                    Qwen3.5-2B-Q4_K_M.gguf                  f6d5376be1edb4d416d56da11e5397a961aca8ae 1280835840 aaf42c8b7c3cab2bf3d69c355048d4a0ee9973d48f16c731c0520ee914699223 2
qwen3.5-4b       unsloth/Qwen3.5-4B-GGUF                    Qwen3.5-4B-Q4_K_M.gguf                  e87f176479d0855a907a41277aca2f8ee7a09523 2740937888 00fe7986ff5f6b463e62455821146049db6f9313603938a70800d1fb69ef11a4 3
qwen3.5-9b       unsloth/Qwen3.5-9B-GGUF                    Qwen3.5-9B-Q4_K_M.gguf                  3885219b6810b007914f3a7950a8d1b469d598a5 5680522464 03b74727a860a56338e042c4420bb3f04b2fec5734175f4cb9fa853daf52b7e8 10
mimo-v2.6-9b     bartowski/MiMo-V2.6-Distill-Qwen-9B-GGUF   MiMo-V2.6-Distill-Qwen-9B-Q4_K_M.gguf   4371da10c84fb26da3592d4cf312d24aa82b7b65 5841049120 4bca6f18c73f72270c7a20c2ea2bea581de8246e318714277120369d34048c81 10
a-final          gh-release:savabs/AWOS_coding_agent-       qwen3.5-4b-r2a-final-Q4_K_M-00001-of-00002.gguf  rl-qwen3.5-4b-r2a-final  1901243296 3d791ae49309908b6b9e5c95a948c621aef233ab6b589c3592737794e7f93733 4
g6-rv2b          gh-release:savabs/AWOS_coding_agent-       qwen3.5-2b-g6-rv-Q4_K_M.gguf  rl-qwen3.5-2b-g6-rv  1274396352 af133cd576eecab134d955de70457aa40f91843d6bd0845d53bf1b2fa6534c62 2
"

# Defaults for push-triggered runs (bench-cloud/rl-eval-**); workflow_dispatch inputs override.
MODELS="qwen3.5-2b qwen3.5-4b qwen3.5-9b mimo-v2.6-9b"
SOURCES="miniwob factory"
# SPLIT=eval means each source's frozen evaluation split: miniwob -> holdout, factory -> ood.
SPLIT="eval"
# N = max tasks per (model, source) before sharding; empty = all tasks in the split.
N=""

# llama.cpp build tag (same as ci/p2_email.env: b11146 = the laptop's Homebrew build).
LLAMA_TAG="b11146"
# Parallel decoding slots on a 4 vCPU / 16 GB runner, and context PER SLOT.
# MiniWoB / factory observations are small (a few dozen controls), 8k per slot is ample.
NP=2
CTX_PER_SLOT=8192
# Seconds a single model call may take on CPU before LocalGBNFModel gives up.
AWOS_LOCAL_TIMEOUT_S=600

# MiniWoB++ pin (scripts/rl/fetch_miniwob.sh; tag v1.1).
MINIWOB_SHA="a7658beb68e1d3572329e06734c5822bd284ddc8"
