# Harness-lift ladder H1 on GitHub Actions (.github/workflows/ladder.yml).
# KEY=VALUE, one per line, no quotes. Parsed by scripts/ladder_collect.py ci-config.
# See ci/README.md. Pre-registration: docs/specs/harness_lift_ladder.md.

# The two job_series arms (H1: AWOS `off` vs mini-swe-agent `mini`).
ARMS=off,mini
# The issue set is split by global sorted index % N_SHARDS.
N_SHARDS=8
# Which shards run: `all`, or a comma list such as `0` (smoke run).
SHARDS=0
# Total USD over ALL N_SHARDS shards; each shard gets CAP / N_SHARDS.
CAP=5
# Issues per shard: empty = all of the shard's issues; 1 = smoke run.
LIMIT=1
REPEAT=1
MODEL=claude-haiku-5-5
# Encrypted dataset release asset (see ci/README.md).
DATA_TAG=bench-data-fresh-v1
DATA_ASSET=fresh_series.tar.gz.enc
