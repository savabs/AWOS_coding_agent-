# Settings for .github/workflows/rl-web.yml (sourced by bash; no secrets, ever).
# Online-Mind2Web on the live web (docs/specs/web_harness.md, milestone M0 of
# docs/research/small_cua_2026-10-25/PLAN.md): CPU llama.cpp + headless Chromium + scaffold.rl.web.
# The GGUFs are the pinned MODEL_SPECS of ci/rl_eval.env (one list for every RL workflow).
# The gated task file is downloaded with the HF_TOKEN repository secret (never stored here).

# Defaults for push-triggered runs (bench-cloud/rl-web-**); workflow_dispatch inputs override.
# M0: base 4B, run A final, base 2B.
MODELS="qwen3.5-4b a-final qwen3.5-2b"
# dev = the fixed 100-task subset (scaffold/rl/web/data/dev_ids.json); all = the 300 tasks.
SPLIT="dev"
# Runner jobs per model (round-robin over the split's tasks). 100 dev tasks / 12 = 8-9 tasks per job.
SHARDS=12
# Per task: model steps, and wall clock in seconds (a 4B step on a 4 vCPU runner takes ~10-40 s).
MAX_STEPS=25
MAX_SECONDS=900

# llama.cpp build tag (same as ci/rl_eval.env).
LLAMA_TAG="b11146"
# Parallel decoding slots (= episode workers per job) and context PER SLOT. Real pages are
# clipped to ~6k prompt tokens (system + goal + history + 40 controls + 3000 chars of text).
NP=2
CTX_PER_SLOT=12288
# Seconds a single model call may take on CPU before LocalGBNFModel gives up.
AWOS_LOCAL_TIMEOUT_S=600
