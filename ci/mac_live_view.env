# Settings for .github/workflows/mac-live-view.yml (sourced by bash).
# Demos to run while you watch: dd_a dd_b dd_c (API-key dashboard variants), teach_t3 (teach-once).
DEMOS="dd_c teach_t3 dd_a"
# Seconds to wait after the viewer link appears, so you can open it before the demos start.
WAIT_BEFORE_S=120
# Seconds between demos.
PAUSE_BETWEEN_S=10
# Minutes to keep the runner (and the live view) up after the demos.
HOLD_MIN=10
