# Settings for .github/workflows/rl-train-dpo.yml on push to bench-cloud/rl-train-dpo-** (no secrets, ever).
# Goal G4 "learn from mistakes": DPO pairs (scaffold.rl.train.pairs) -> kaggle/rl-sft/train.py objective=dpo.
# SUCCESS_RUNS: runs whose verified, safe TRAIN-split successes are "chosen" (Claude Sonnet distillation).
SUCCESS_RUNS="39973466526 40003832864"
# POLICY_RUNS: Qwen 4B TRAIN collections: failures are "rejected", successes join "chosen".
# (39817774382 is the EVAL baseline: never listed here; the workflow refuses it.)
POLICY_RUNS="39852748367 39864014413"
# oracle demos (factory + miniwob train) as chosen
ORACLE=true
# cap on train pairs (safety pairs always kept): ~1.3k pairs ~2 h on T4 x2 at 8 pairs per optimizer step
MAX_TRAIN_PAIRS=1300
SIZE=4B
KERNEL_SLUG=awos-rl-sft-g4-dpo
DATASET_SLUG=awos-rl-sft-data-g4-dpo
# train_config overrides; the rest are train.py DEFAULTS + DPO_DEFAULTS (beta 0.1, sft_weight 1, lr 2e-5, max_hours 3)
CONFIG="objective=dpo run_name=G4-dpo"
# true = upload the dataset to Kaggle and start the training kernel
PUSH=true
