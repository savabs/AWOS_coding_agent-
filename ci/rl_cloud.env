# Settings for .github/workflows/rl-cloud.yml (sourced by bash; no secrets, ever).
# Claude models through the same harness + MicroAgent as the local models (scaffold.rl.harness --model cloud).
# Uses the repo secret ANTHROPIC_API_KEY. One job per line x shard:
#   name  model  source  split  shards  cap_usd(total for the line)
# Measured 2026-10-23 (smoke run 39972510131): Sonnet 5.5 ~$0.0044/step, Opus 5.5 (effort low) ~$0.0057/step.
# split "train" = distillation data (successful, safe episodes become SFT rows in the local text format);
# split holdout/ood = the frozen exam (ceiling test, compare with docs/research/rl_cua_2026-10-22/BASELINE.md).
JOBS="
ceil-sonnet   claude-sonnet-5-5  factory  ood      1  3.5
ceil-sonnet   claude-sonnet-5-5  miniwob  holdout  2  5
ceil-opus     claude-opus-5-5    factory  ood      2  5
ceil-opus     claude-opus-5-5    miniwob  holdout  3  7
distill-son   claude-sonnet-5-5  factory  train    4  15
distill-son   claude-sonnet-5-5  miniwob  train    4  19
"
# parallel episodes per job (API-bound; each worker runs one headless Chromium)
WORKERS=3
# Opus 5.5 always thinks: effort sets how much (low keeps it cheap); Sonnet 5.5 runs with thinking off.
AWOS_CLOUD_EFFORT=low
