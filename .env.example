# Copy to .env and fill values. Real .env is gitignored — never commit secrets.
# LiteLLM env var reference: https://aider.chat/docs/llms/other.html

# ── GitHub (GitHubTool — higher rate limits & write access) ────────────────
GITHUB_TOKEN=

# ── Internet search backends (WebSearchTool falls back to DuckDuckGo if unset) ──
# SerpAPI: https://serpapi.com/dashboard
SERP_API_KEY=
# Google Custom Search: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ── Agentic search ─────────────────────────────────────────────────────────
# Tavily — purpose-built for AI agents; PRIMARY WebSearchTool backend
# https://app.tavily.com/
TAVILY_API_KEY=

# ── HuggingFace ─────────────────────────────────────────────────────────────
# https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Experiment tracking ─────────────────────────────────────────────────────
# Weights & Biases — https://wandb.ai/settings
WANDB_API_KEY=
WANDB_ENTITY=

# ── ML platforms ────────────────────────────────────────────────────────────
# Kaggle — https://www.kaggle.com/settings
KAGGLE_API_TOKEN=

# ── Execution safety gates ──────────────────────────────────────────────────
# Set to 1 to allow ShellTool to run potentially destructive commands
ALLOW_SHELL=
# Set to 1 to allow PythonRunnerTool to execute arbitrary Python code
ALLOW_CODE_EXEC=

# ── Model access: ONE key ───────────────────────────────────────────────────
# OpenRouter — https://openrouter.ai/keys
# When set, EVERY model call (worker, planner, critic, reviewer, chat, agent
# loop) routes through OpenRouter and the direct keys below are ignored.
# See docs/specs/openrouter_only_spec.md. Verify: python3 awos.py models
OPENROUTER_API_KEY=
AWOS_AGENT_MODEL=anthropic/claude-haiku-4.5

# ── Direct provider keys (legacy; unused while OPENROUTER_API_KEY is set) ──
ANTHROPIC_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Together AI — https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Fireworks — https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=


# ═══════════════════════════════════════════════════════════════════════════
# Running the agent WITHOUT paying, and without a key
# ═══════════════════════════════════════════════════════════════════════════
# Three ways to drive `awos agent`, cheapest first. Each is independent —
# none of the keys above is needed for the first two.

# 1. LOCAL MODEL — free, unlimited, no key. Any OpenAI-compatible server:
#    Ollama (`ollama serve`), LM Studio, vLLM, llama.cpp.
#    Tool calling needs a model that supports it, e.g. qwen2.5-coder.
# AWOS_BASE_URL=http://localhost:11434/v1
# AWOS_AGENT_MODEL=qwen2.5-coder

# 2. CASSETTE — record one run, replay it forever offline for free.
#    Record:  awos agent "<goal>" --cassette .awos/cassettes/x.json --record
#    Replay:  awos agent "<goal>" --cassette .awos/cassettes/x.json
#    Replay needs no credentials at all, so it is what CI should use.
# AWOS_CASSETTE=.awos/cassettes/my_run.json
# AWOS_CASSETTE_MODE=replay
# AWOS_CASSETTE_STRICT=1    # fail on divergence instead of replaying in order

# 3. OPENROUTER — one key, many vendors. OpenAI-compatible, so it uses the
#    same code path as a local model. No default model: ids are
#    vendor-prefixed and the catalogue changes, so pick one explicitly, and
#    pick one that supports TOOL CALLING — the agent loop is driven by tool
#    calls, and a model without them will talk instead of acting.
#      see https://openrouter.ai/models
#    Verify with: python3 scripts/check_backend.py
# OPENROUTER_API_KEY=
# AWOS_AGENT_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_SITE_URL=            # optional, for OpenRouter's rankings page
# OPENROUTER_APP_NAME=            # optional

# 4. PAID API, with a hard ceiling on a single run (USD).
#    Also available as `awos agent --max-cost 0.25`.
# AWOS_MAX_RUN_COST=0.25

# Which backend runs, when several are configured. Order is:
#   AWOS_BASE_URL > OPENROUTER_API_KEY > ANTHROPIC > DEEPSEEK > OPENAI
# Pin one to remove the guesswork: local | openrouter | anthropic | deepseek | openai
# AWOS_PROVIDER=openrouter
